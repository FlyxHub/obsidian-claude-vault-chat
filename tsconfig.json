{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": [
			"node"
		],
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/**/*.ts"
	]
}
